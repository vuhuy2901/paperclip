DATABASE_URL=sqlite:///./data/core.db
SERVICE_TOKEN=dev-service-token
ARTIFACT_ROOT=./data/artifacts
MAX_REPAIRS=3

# Model providers. Keep OPENROUTER_API_KEY only in a local .env file.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://ollama:11434

# Role model defaults (provider mapping; runtime adapters are configured separately).
AI_PM_MODEL=openrouter/free
AI_ARCHITECT_MODEL=openrouter/free
AI_UIUX_MODEL=qwen2.5:0.5b
AI_BACKEND_MODEL=openrouter/free
AI_FRONTEND_MODEL=openrouter/free
AI_REVIEWER_MODEL=qwen2.5:0.5b
AI_TESTER_MODEL=qwen2.5:0.5b
AI_DEVOPS_MODEL=qwen2.5:0.5b
