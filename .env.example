DATABASE_URL=sqlite:///./data/core.db
SERVICE_TOKEN=dev-service-token
ARTIFACT_ROOT=./data/artifacts
MAX_REPAIRS=3

# Local model endpoint.
OLLAMA_BASE_URL=http://ollama:11434

# Ollama is the only model provider used by the default stack.
DEFAULT_RUNNER=ollama
DEFAULT_MODEL=llama3.2:3b
OLLAMA_MODEL=llama3.2:3b

# Role model defaults.
AI_PM_MODEL=llama3.2:3b
AI_ARCHITECT_MODEL=llama3.2:3b
AI_UIUX_MODEL=llama3.2:3b
AI_BACKEND_MODEL=llama3.2:3b
AI_FRONTEND_MODEL=llama3.2:3b
AI_REVIEWER_MODEL=llama3.2:3b
AI_TESTER_MODEL=llama3.2:3b
AI_DEVOPS_MODEL=llama3.2:3b

